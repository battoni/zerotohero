# Supabase — Settings > Data API (Project URL) and Settings > API Keys (Publishable key).
# The publishable key is public by design; Row Level Security protects the data.
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Server-only. Used by `npm run seed` locally. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PROJECT_REF=<project-ref>

NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows the email/password form on /login outside `nuxt dev` (preview/e2e only).
NUXT_PUBLIC_DEV_LOGIN=false

# Seed: the real account that receives the personal trails in seed/personal/.
SEED_OWNER_EMAIL=
# Seed: password for the demo users (Ana, Rafa, Lu) and the e2e user.
SEED_DEMO_PASSWORD=
