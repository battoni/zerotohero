# Supabase — Settings > Data API (Project URL) and Settings > API Keys (Publishable key).
# The publishable key is public by design; Row Level Security protects the data.
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_...
# The subdomain of the URL above; used by `npx supabase link` and `npm run db:types`.
SUPABASE_PROJECT_REF=<project-ref>

# Settings > API Keys > Secret keys. Server-only, never exposed to the browser.
# The app reads it at runtime (signed URLs for evidence files) and `npm run seed` reads it too.
# On the host, set it as a runtime variable, not at build time.
NUXT_SUPABASE_SECRET_KEY=sb_secret_...

# OAuth redirects (<site>/confirm) and absolute URLs (canonical, hreflang).
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# demo | supabase. Defaults to supabase when a Supabase URL is set.
# NUXT_PUBLIC_DATA_MODE=demo
# Shows the email/password form on /login outside `nuxt dev` (preview/e2e only).
# NUXT_PUBLIC_DEV_LOGIN=true

# Seed: the account that receives the personal trails in seed/personal/. It must exist first.
SEED_OWNER_EMAIL=
# Seed: password for the demo users (Ana, Rafa, Lu, Bruno, Carla) and the e2e user; at least 8 characters.
SEED_DEMO_PASSWORD=
